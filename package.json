{
  "name": "gestao-emprestimos",
  "version": "1.0.0",
  "description": "Site de gestão de empréstimos com conta central, afiliados, cadastro com documentos, cobranças automáticas e WhatsApp",
  "main": "server.js",
  "private": true,
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "build:vendor": "esbuild vendor/blob-client.mjs --bundle --format=esm --platform=browser --minify --outfile=public/vendor/blob-client.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "esbuild": "^0.28.2"
  }
}
